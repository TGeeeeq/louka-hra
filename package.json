{
  "name": "louka-survival",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Louka – survival hra azylu Nech mě růst z.s. Péče o zachráněná zvířata uprostřed lesů.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "photos": "node scripts/fetch-photos.mjs",
    "assets:app": "node scripts/make-app-assets.mjs && npx -y @capacitor/assets generate --android",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/preferences": "^8.0.1",
    "cordova-plugin-purchase": "^13.18.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@capacitor/android": "^8.4.2",
    "@capacitor/cli": "^8.4.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "sharp": "^0.35.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
